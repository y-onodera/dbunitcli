rowEntry() ::= <<
    {
      "sheetName": "$first(rows).SHEET_NAME$"
     ,"tableName": "$tableName$"
     ,"header": [$rows:{row | "$row.COLUMN_NAME$"}; separator=","$]
     ,"dataStart": $first(rows).DATA_START$
     ,"columnIndex": [$rows:{row | $row.COLUMN_INDEX$}; separator=","$]
     ,"breakKey": [$if(dataset.PK.rows)$$dataset.PK.rows:{row | "$row.COLUMN_NAME$"}; separator=","$$else$"$first(rows).COLUMN_NAME$"$endif$]
    }
>>

cellEntry() ::= <<
    {
      "sheetName": "$first(dataset.CELLS.rows).SHEET_NAME$"
     ,"tableName": "$tableName$"
     ,"header": [$dataset.CELLS.rows:{row | "$row.COLUMN_NAME$"}; separator=","$]
     ,"rows": [{"cellAddress": [$dataset.CELLS.rows:{row | "$row.CELL_ADDRESS$"}; separator=","$]}]
    }
>>
