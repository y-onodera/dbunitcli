rowEntry() ::= <<
    {
      "sheetName": "$tableName$"
     ,"tableName": "$tableName$"
     ,"header": [$rows:{row | "$row.COLUMN_NAME$"}; separator=","$]
     ,"dataStart": 1
     ,"columnIndex": [$rows:{row | $i0$}; separator=","$]
     ,"breakKey": [$if(dataset.PK.rows)$$dataset.PK.rows:{row | "$row.COLUMN_NAME$"}; separator=","$$else$"$first(rows).COLUMN_NAME$"$endif$]
    }
>>
