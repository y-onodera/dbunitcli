{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/start-maven-proxy.sh\""
					},
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR/tauri\" && bun install --frozen-lockfile 1>&2 || true",
						"timeout": 120
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tauri-test.sh\"",
						"timeout": 120
					}
				]
			}
		]
	}
}
